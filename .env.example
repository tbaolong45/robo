# Copy to .env and fill in. .env is gitignored - never commit real values.

# --- LLM (OpenAI-compatible: GLM, DeepSeek, ...) -----------------------------
# Judging tasks (priority, duration, energy) and, in `pli agent`, the mail summaries and
# answers. Optional - without a key the planner falls back to deterministic heuristics and
# still produces a week, and the agent labels mail but writes no summaries.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- TypeSafe (the judgement layer over captured page content) ---------------
# Required for anything that reads a page: an Outlook calendar row and a Teams
# post are both judged rather than pattern-matched. Get a key at
# https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# --- Voice input (`pli agent --voice`) ---------------------------------------
# Speech-to-text runs on THIS machine with faster-whisper; your voice is never
# uploaded. Needs `uv sync --extra voice` and `sudo apt install libportaudio2`.
# The model downloads on first use: tiny.en ~75 MB, base.en ~145 MB, small.en ~484 MB.
STT_MODEL=base.en

# --- Deadlines (`what is due`) -------------------------------------------------
# Notices ("Due on ...", "Overdue: ...", "You have submitted ...") only count when they
# come from this sender, exactly as the inbox shows it. Anyone else's are ignored.
DEADLINE_SENDER=LMS

# --- Web lookups (`pli agent`: "search the web for ...", or a question about today) --
# The typed question goes to a search engine and public pages are read in a fresh,
# signed-out browser (never your Outlook profile). Searching needs
# LLM_BASE_URL=https://openrouter.ai/api/v1 (its web-search plugin, about $0.007 a search);
# an address you type is opened with any endpoint. false turns lookups off.
WEB_ENABLED=true

# --- Activity watching (`pli watch`, opt-in) ----------------------------------
# Local counts only: active minutes, git commits, files edited, visits to the sites
# below. No page titles, URLs, file names, commit messages or shell commands are
# stored. Data stays in data/activity.db (mode 0600) and is deleted after N days.
ACTIVITY_ROOTS=~/logrian
ACTIVITY_DOMAINS=github.com,docs.python.org,stackoverflow.com,outlook.office.com,teams.microsoft.com,learn.chatgpt.com
ACTIVITY_RETENTION_DAYS=30
# Leave empty to use Brave's default profile history.
ACTIVITY_HISTORY_PATH=

# --- The browser -------------------------------------------------------------
# There is NO app registration and NO Microsoft credentials stored anywhere.
# The tool drives a real Chromium profile - the same browser you would use - and
# borrows whatever session it already holds. You sign in by hand, once.
#
# Where that persistent profile lives. It holds LIVE session cookies for your
# university account, so it is gitignored (see .gitignore) and should stay that
# way wherever you point it.
BROWSER_PROFILE=data/browser
# true  - no window: the normal mode, and the only one a scheduled run can use.
# false - a real window opens. This is how you sign in when the session has
#         expired: run any reading command with this set, complete the sign-in
#         in the window, and the profile keeps it for every later run.
BROWSER_HEADLESS=true
# Slow every browser action down by this many milliseconds. 0 is fine; a small
# delay (e.g. 250) helps if a page renders its events a beat after the read.
BROWSER_SLOW_MO_MS=0
# The Outlook calendar view the planner reads and writes the Study Plan into.
OUTLOOK_URL=https://outlook.office.com/calendar/view/week
# The Teams web client the channel messages are read from.
TEAMS_URL=https://teams.microsoft.com/

# --- Moodle (Phase 2) --------------------------------------------------------
MOODLE_BASE_URL=https://moodle.example.ac.th
# Optional: if set, the token ladder uses this and skips acquisition entirely.
MOODLE_TOKEN=

# --- Local -------------------------------------------------------------------
# IANA timezone for interpreting study hours and writing calendar events.
# Leave blank to detect from the system.
PLI_TIMEZONE=
# Where the ledger, archive and search index live.
PLI_HOME=data
